# Local & Production Backend Environment Variables (copy to .env — never commit .env)
APP_URL="http://localhost:3000"

# Persistent Database (@libsql/client: local SQLite file or free-tier Turso libSQL URL)
# Example Turso URL: libsql://your-db-your-org.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# 32-byte encryption key for encrypting user Gemini & Buffer API keys at rest (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
SESSION_SECRET=

# Optional comma-separated origins allowed when connecting your GitHub Pages frontend to this backend
# Example: ALLOWED_CORS_ORIGINS="https://bethelhouseholdoffaith-png.github.io"
ALLOWED_CORS_ORIGINS=

# First Administrator Bootstrap (recommended for initial production deployment)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional email delivery for password resets (e.g., Resend)
RESEND_API_KEY=
MAIL_FROM=

# Optional server fallback keys (user accounts store their own encrypted keys per-user)
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL="gemini-4-hydrogen"
BUFFER_API_KEY=
