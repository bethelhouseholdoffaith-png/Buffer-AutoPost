# GEMINI_API_KEY: Optional server-side fallback key (users supply their own key in browser onboarding via HttpOnly cookie).
GEMINI_API_KEY=""

# GEMINI_VIDEO_MODEL: Video-capable Gemini model ID used for uploaded video title analysis.
GEMINI_VIDEO_MODEL="gemini-4-hydrogen"

# BUFFER_API_KEY: Optional server-side fallback token (users supply their own key in browser onboarding via HttpOnly cookie).
BUFFER_API_KEY=""

# APP_URL: Public base URL where this app is hosted (used for public media URLs sent to Buffer).
APP_URL=""
